# Kopiera till .env.local för lokal utveckling. Lägg in samma värden under
# Settings → Environment Variables i Vercel.

# Supabase → Project Settings → Data API (URL) och API Keys (publishable/anon-nyckeln)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase → Connect → "Transaction pooler" (port 6543). Används bara på servern.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:LÖSENORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# Supabase Storage-bucket för spelarbilder och lagloggor (skapas av supabase/setup.sql)
NEXT_PUBLIC_STORAGE_BUCKET=images

# Lagets egen logga. Peka om till t.ex. Supabase Storage när bilderna flyttats.
NEXT_PUBLIC_OWN_TEAM_LOGO_URL=https://skabersjoifp13.retool.com/api/file/1b186491-0085-4624-810b-a243328c9160

# Behövs BARA för att köra scripts/migrate-images.mjs lokalt. Service role-nyckeln
# ger full åtkomst till databasen – lägg den aldrig i Vercel eller i Git.
# Supabase → Project Settings → API Keys → Secret key
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_... (eller den äldre service_role-nyckeln eyJ...)

# Sätt till "disable" om du kör mot en lokal Postgres utan SSL.
# DATABASE_SSL=disable

# Skyddar den nattliga hämtningen från Svenskalag (/api/cron/svenskalag).
# Sätts i Vercel; behövs inte lokalt.
# CRON_SECRET=långt-slumpat-värde
